# Copy this file to .env and fill in your values for local development.
# Never commit .env to git.

# Required: your OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: restrict CORS to your production frontend URL
# Leave empty or set to * to allow all origins (fine for local dev)
ALLOWED_ORIGIN=https://your-app.vercel.app

# Optional: override the OpenAI model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: override the port (default: 3001)
PORT=3001
